Pre-Depends: ${misc:Pre-Depends}
Depends: ${misc:Depends}, ${shlibs:Depends}, libxfce4windowing-common
Breaks: budgie-core (<< 10.9.2-4~), xfce4-panel (<< 4.19.5~), xfdesktop4 (<< 4.19.5~)
Description: Wayland utility functions library for Xfce4
 an abstraction library that attempts to present windowing concepts (screens,
 toplevel windows, workspaces, etc.) in a windowing-system-independent manner.

Package: libxfce4windowing-0-dev
Architecture: any
Multi-Arch: same
Section: libdevel
Depends: ${misc:Depends},
         ${gir:Depends},
         gir1.2-libxfce4windowing-0.0 (= ${binary:Version}),
         gir1.2-libxfce4windowingui-0.0 (= ${binary:Version}),
         libgtk-3-dev,
         libwayland-dev [linux-any],
         libxfce4windowing-0-0 (= ${binary:Version}),
Provides: ${gir:Provides}
Description: Development files for libxfce4windowing
 This package contains the headers for libxfce4windowing. If you intend to code
 wayland applications for the Xfce4 desktop environment, you need to install
 this package.
 .
 The libxfce4windowing Reference Manual is also included and
 it can be consulted using Devhelp or a web browser.

